/* Global */
QMainWindow, QWidget#centralRoot {
    background-color: #212121;
    color: #ececec;
}

/* Header */
QFrame#headerBar {
    background-color: #171717;
    border-bottom: 1px solid #2f2f2f;
}

QLabel#appTitle {
    font-size: 15px;
    font-weight: 600;
    color: #f3f3f3;
}

QLabel#wordLimitLabel {
    font-size: 12px;
    color: #a0a0a0;
}

QComboBox#wordLimitCombo {
    min-width: 72px;
    padding: 8px 12px;
    border: 1px solid #3a3a3a;
    border-radius: 8px;
    background-color: #2a2a2a;
    color: #ececec;
    font-size: 13px;
}

QComboBox#wordLimitCombo:hover {
    border-color: #525252;
}

QComboBox#wordLimitCombo::drop-down {
    border: none;
    width: 24px;
}

QComboBox#wordLimitCombo QAbstractItemView {
    background-color: #2a2a2a;
    border: 1px solid #3a3a3a;
    selection-background-color: #404040;
    color: #ececec;
    outline: none;
}

QLabel#statusLabel {
    font-size: 12px;
    color: #8e8e8e;
}

QComboBox#modelCombo {
    min-width: 200px;
    padding: 8px 12px;
    border: 1px solid #3a3a3a;
    border-radius: 8px;
    background-color: #2a2a2a;
    color: #ececec;
    font-size: 13px;
}

QComboBox#modelCombo:hover {
    border-color: #525252;
}

QComboBox#modelCombo::drop-down {
    border: none;
    width: 28px;
}

QComboBox#modelCombo QAbstractItemView {
    background-color: #2a2a2a;
    border: 1px solid #3a3a3a;
    selection-background-color: #404040;
    color: #ececec;
    outline: none;
}

QPushButton#listenButton {
    padding: 8px 14px;
    border: 1px solid #3a3a3a;
    border-radius: 8px;
    background-color: transparent;
    color: #ececec;
    font-size: 13px;
}

QPushButton#listenButton:checked {
    background-color: #10a37f;
    border-color: #10a37f;
    color: #ffffff;
}

QPushButton#listenButton:hover {
    background-color: #2f2f2f;
}

QPushButton#listenButton:checked:hover {
    background-color: #0d8f6e;
}

QPushButton#newChatButton {
    padding: 8px 14px;
    border: 1px solid #3a3a3a;
    border-radius: 8px;
    background-color: transparent;
    color: #ececec;
    font-size: 13px;
}

QPushButton#newChatButton:hover {
    background-color: #2f2f2f;
}

QPushButton#newChatButton:pressed {
    background-color: #383838;
}

/* Chat scroll area */
QScrollArea#chatScroll {
    border: none;
    background-color: #212121;
}

QWidget#messageContainer {
    background-color: #212121;
}

/* Input bar */
QFrame#inputBar {
    background-color: #212121;
    border-top: 1px solid #2f2f2f;
}

QTextEdit#messageInput {
    border: 1px solid #3a3a3a;
    border-radius: 12px;
    padding: 12px 14px;
    background-color: #2f2f2f;
    color: #ececec;
    font-size: 14px;
    selection-background-color: #505050;
}

QTextEdit#messageInput:focus {
    border-color: #6b6b6b;
}

QPushButton#sendButton {
    min-width: 44px;
    max-width: 44px;
    min-height: 44px;
    max-height: 44px;
    border: none;
    border-radius: 10px;
    background-color: #10a37f;
    color: white;
    font-size: 18px;
    font-weight: bold;
}

QPushButton#sendButton:hover {
    background-color: #0d8f6e;
}

QPushButton#sendButton:pressed {
    background-color: #0a7a5e;
}

QPushButton#sendButton:disabled {
    background-color: #3d3d3d;
    color: #777777;
}

QPushButton#stopButton {
    padding: 10px 16px;
    border: 1px solid #5c3d3d;
    border-radius: 10px;
    background-color: #3a2828;
    color: #f0a0a0;
    font-size: 13px;
}

QPushButton#stopButton:hover {
    background-color: #4a3232;
}

QComboBox#micCombo,
QComboBox#speakerCombo {
    min-width: 180px;
    max-width: 260px;
    padding: 8px 10px;
    border: 1px solid #3a3a3a;
    border-radius: 10px;
    background-color: #2a2a2a;
    color: #ececec;
    font-size: 13px;
}

QComboBox#micCombo::drop-down,
QComboBox#speakerCombo::drop-down {
    border: none;
    width: 24px;
}

QComboBox#micCombo QAbstractItemView,
QComboBox#speakerCombo QAbstractItemView {
    background-color: #2a2a2a;
    border: 1px solid #3a3a3a;
    selection-background-color: #404040;
    color: #ececec;
    outline: none;
}

QPushButton#refreshMicsButton,
QPushButton#recordButton {
    min-height: 44px;
    max-height: 44px;
    padding: 0 12px;
    border: 1px solid #3a3a3a;
    border-radius: 10px;
    background-color: #2a2a2a;
    color: #ececec;
    font-size: 13px;
}

QPushButton#refreshMicsButton {
    min-width: 44px;
    max-width: 44px;
    font-size: 16px;
}

QPushButton#refreshMicsButton:hover,
QPushButton#recordButton:hover {
    background-color: #353535;
}

QPushButton#recordButton[recording="true"] {
    background-color: #8f2d2d;
    border-color: #c45c5c;
    color: #ffffff;
}

QPushButton#recordButton:disabled,
QPushButton#refreshMicsButton:disabled,
QComboBox#micCombo:disabled,
QComboBox#speakerCombo:disabled {
    color: #777777;
    background-color: #2a2a2a;
}

QProgressBar#micLevel {
    min-width: 56px;
    max-width: 56px;
    min-height: 8px;
    max-height: 8px;
    border: none;
    border-radius: 4px;
    background-color: #2a2a2a;
}

QProgressBar#micLevel::chunk {
    border-radius: 4px;
    background-color: #4caf50;
}

/* Scrollbar */
QScrollBar:vertical {
    background: #212121;
    width: 10px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #424242;
    min-height: 24px;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background: #525252;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}
